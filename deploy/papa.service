# /etc/systemd/system/papa.service
# sudo systemctl enable --now papa
[Unit]
Description=PAPA control software
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/papa-software
Environment=PYTHONUNBUFFERED=1
# Drop PAPA_SIM once the hardware is wired and tested.
# Environment=PAPA_SIM=1
ExecStart=/home/pi/papa-software/.venv/bin/python -m apps.server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
