import cv2
import numpy as np
import subprocess
from pathlib import Path

# Save photos next to this script, regardless of where it is launched.
folder = Path(__file__).resolve().parent
original = folder / 'electrode.jpg'
processed = folder / 'red_detected.jpg'

print('Starting Raspberry Pi HQ Camera...')
try:
    subprocess.run([
        'rpicam-still', '-t', '5000',
        '--width', '4056', '--height', '3040',
        '-o', str(original)
    ], check=True)
except (FileNotFoundError, subprocess.CalledProcessError) as exc:
    raise SystemExit(f'Camera capture failed: {exc}')

image = cv2.imread(str(original))
if image is None:
    raise SystemExit(f'Could not read captured photo: {original}')

hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
lower_red1 = np.array([0, 100, 80])
upper_red1 = np.array([10, 255, 255])
lower_red2 = np.array([170, 100, 80])
upper_red2 = np.array([179, 255, 255])
mask1 = cv2.inRange(hsv, lower_red1, upper_red1)
mask2 = cv2.inRange(hsv, lower_red2, upper_red2)
mask = cv2.bitwise_or(mask1, mask2)
kernel = np.ones((5, 5), np.uint8)
mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)
contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

count = 0
for contour in contours:
    if cv2.contourArea(contour) > 100:
        (x, y), radius = cv2.minEnclosingCircle(contour)
        center = (int(x), int(y))
        cv2.circle(image, center, int(radius), (0, 255, 0), 4)
        count += 1
        print(f'Red region {count}: center = {center}, radius = {radius:.1f} pixels')

if not cv2.imwrite(str(processed), image):
    raise SystemExit('Could not save processed photo')
print(f'Done! Detected {count} red region(s).')
print(f'Original: {original}')
print(f'Processed: {processed}')

try:
    subprocess.Popen(['xdg-open', str(processed)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
except FileNotFoundError:
    print('Image viewer unavailable; open the processed file manually.')
