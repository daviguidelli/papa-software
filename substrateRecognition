
import cv2
import numpy as np
import subprocess
import json
from pathlib import Path

# ==========================================
# PAPA CAMERA - SUBSTRATE DETECTION
# ==========================================

BASE_DIR = Path(__file__).resolve().parent
SCANS_DIR = BASE_DIR / "scans"

PHOTO_WIDTH = 4056
PHOTO_HEIGHT = 3040
PREVIEW_TIME = 5000

# Red marker detection
MIN_RED_AREA = 100
RED_CLOSE_KERNEL = 31

# Pairing settings
MIN_DIAGONAL_DX = 10
MIN_DIAGONAL_DY = 10
MAX_PAIR_DISTANCE = 1200

# If you know the marker spacing in pixels,
# enter it here to improve pairing.
EXPECTED_DX = None
EXPECTED_DY = None
PAIR_TOLERANCE = 0.30

# Numbering and label settings
ROW_TOLERANCE = 150
LABEL_SCALE = 2.0
LABEL_THICKNESS = 5


# ==========================================
# 1. CREATE SCAN FOLDER
# ==========================================

def create_scan_folder():
    SCANS_DIR.mkdir(exist_ok=True)

    existing_ids = []

    for folder in SCANS_DIR.glob("scan_*"):
        if folder.is_dir():
            try:
                existing_ids.append(
                    int(folder.name.split("_")[-1])
                )
            except ValueError:
                pass

    scan_id = max(existing_ids, default=0) + 1
    folder = SCANS_DIR / f"scan_{scan_id:04d}"
    folder.mkdir()

    return folder, scan_id


# ==========================================
# 2. CAPTURE ORIGINAL PHOTOGRAPH
# ==========================================

def capture_photo(folder):
    photo_path = folder / "original.jpg"

    print("Taking camera photograph...")

    subprocess.run(
        [
            "rpicam-still",
            "-t", str(PREVIEW_TIME),
            "--width", str(PHOTO_WIDTH),
            "--height", str(PHOTO_HEIGHT),
            "-o", str(photo_path)
        ],
        check=True
    )

    return photo_path


# ==========================================
# 3. FIND RED MARKERS
# ==========================================

def detect_red_markers(image):
    hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)

    mask1 = cv2.inRange(
        hsv,
        np.array([0, 100, 80]),
        np.array([10, 255, 255])
    )

    mask2 = cv2.inRange(
        hsv,
        np.array([170, 100, 80]),
        np.array([179, 255, 255])
    )

    mask = cv2.bitwise_or(mask1, mask2)

    # Remove small red noise
    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_OPEN,
        np.ones((5, 5), np.uint8)
    )

    # Connect fragmented regions of one marker
    kernel = cv2.getStructuringElement(
        cv2.MORPH_ELLIPSE,
        (RED_CLOSE_KERNEL, RED_CLOSE_KERNEL)
    )

    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_CLOSE,
        kernel
    )

    contours, _ = cv2.findContours(
        mask,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    markers = []

    for contour in contours:
        area = cv2.contourArea(contour)

        if area < MIN_RED_AREA:
            continue

        (x, y), radius = cv2.minEnclosingCircle(
            contour
        )

        markers.append({
            "x": round(float(x), 2),
            "y": round(float(y), 2),
            "radius": round(float(radius), 2),
            "area": round(float(area), 2)
        })

    markers.sort(
        key=lambda m: (m["y"], m["x"])
    )

    print(f"Red markers detected: {len(markers)}")

    return markers


# ==========================================
# 4. PAIR DIAGONAL MARKERS
# ==========================================

def pair_markers(markers):
    candidates = []

    for i in range(len(markers)):
        for j in range(len(markers)):

            if i == j:
                continue

            a = markers[i]
            b = markers[j]

            # a must be the upper-right marker
            # b must be the lower-left marker
            dx = a["x"] - b["x"]
            dy = b["y"] - a["y"]

            if dx < MIN_DIAGONAL_DX:
                continue

            if dy < MIN_DIAGONAL_DY:
                continue

            distance = float(np.hypot(dx, dy))

            if distance > MAX_PAIR_DISTANCE:
                continue

            # Check expected marker spacing, if provided
            if EXPECTED_DX is not None:
                if abs(dx - EXPECTED_DX) > EXPECTED_DX * PAIR_TOLERANCE:
                    continue

            if EXPECTED_DY is not None:
                if abs(dy - EXPECTED_DY) > EXPECTED_DY * PAIR_TOLERANCE:
                    continue

            if EXPECTED_DX is not None and EXPECTED_DY is not None:
                score = (
                    abs(dx - EXPECTED_DX) / EXPECTED_DX
                    + abs(dy - EXPECTED_DY) / EXPECTED_DY
                )
            else:
                score = distance

            candidates.append({
                "i": i,
                "j": j,
                "distance": distance,
                "score": score
            })

    candidates.sort(key=lambda c: c["score"])

    used = set()
    substrates = []

    for candidate in candidates:
        i = candidate["i"]
        j = candidate["j"]

        if i in used or j in used:
            continue

        a = markers[i]
        b = markers[j]

        substrates.append({
            "marker_1": a,
            "marker_2": b,
            "center_x": round((a["x"] + b["x"]) / 2, 2),
            "center_y": round((a["y"] + b["y"]) / 2, 2),
            "pair_distance_px": round(candidate["distance"], 2)
        })

        used.add(i)
        used.add(j)

    unmatched = [
        i for i in range(len(markers))
        if i not in used
    ]

    return substrates, unmatched


# ==========================================
# 5. ASSIGN UNIQUE SUBSTRATE NUMBERS
# ==========================================

def number_substrates(substrates):
    ordered = sorted(
        substrates,
        key=lambda s: (
            s["center_y"],
            s["center_x"]
        )
    )

    rows = []

    for substrate in ordered:
        matching_row = None

        for row in rows:
            if abs(
                substrate["center_y"] -
                row["average_y"]
            ) <= ROW_TOLERANCE:
                matching_row = row
                break

        if matching_row is None:
            rows.append({
                "average_y": substrate["center_y"],
                "items": [substrate]
            })
        else:
            matching_row["items"].append(substrate)

            matching_row["average_y"] = float(
                np.mean([
                    s["center_y"]
                    for s in matching_row["items"]
                ])
            )

    rows.sort(key=lambda r: r["average_y"])

    numbered = []

    for row in rows:
        row["items"].sort(
            key=lambda s: s["center_x"]
        )

        for substrate in row["items"]:
            substrate["substrate_id"] = len(numbered) + 1
            numbered.append(substrate)

    return numbered


# ==========================================
# 6. DRAW CIRCLES AND BLACK SUBSTRATE LABELS
# ==========================================

def annotate_image(image, markers, substrates):
    # Preserve the original color photograph
    output = image.copy()

    # Green circle around EVERY detected red marker
    for marker in markers:
        x = int(marker["x"])
        y = int(marker["y"])
        radius = max(10, int(marker["radius"]) + 5)

        cv2.circle(
            output,
            (x, y),
            radius,
            (0, 255, 0),
            5
        )

    # One black label at the center of each pair
    for substrate in substrates:
        center_x = int(substrate["center_x"])
        center_y = int(substrate["center_y"])

        label = f"S{substrate['substrate_id']}"

        (text_width, text_height), baseline = (
            cv2.getTextSize(
                label,
                cv2.FONT_HERSHEY_SIMPLEX,
                LABEL_SCALE,
                LABEL_THICKNESS
            )
        )

        text_x = center_x - text_width // 2
        text_y = center_y + text_height // 2

        cv2.putText(
            output,
            label,
            (text_x, text_y),
            cv2.FONT_HERSHEY_SIMPLEX,
            LABEL_SCALE,
            (0, 0, 0),
            LABEL_THICKNESS,
            cv2.LINE_AA
        )

    return output


# ==========================================
# 7. SAVE ONLY TWO PHOTOGRAPHS + JSON
# ==========================================

def save_results(
    folder,
    scan_id,
    annotated,
    markers,
    substrates,
    unmatched
):
    # original.jpg was already saved by the camera.
    # This is the ONLY additional image saved.
    detected_path = folder / "detected.jpg"

    if not cv2.imwrite(
        str(detected_path),
        annotated
    ):
        raise RuntimeError(
            "Could not save detected.jpg"
        )

    results = {
        "scan_id": scan_id,
        "image_width": PHOTO_WIDTH,
        "image_height": PHOTO_HEIGHT,
        "coordinate_units": "pixels",
        "marker_count": len(markers),
        "substrate_count": len(substrates),
        "pairing_verified": False,
        "substrates": substrates,
        "unmatched_markers": [
            markers[i] for i in unmatched
        ]
    }

    with open(
        folder / "substrates.json", "w"
    ) as file:
        json.dump(results, file, indent=4)

    return detected_path


# ==========================================
# 8. MAIN PROGRAM
# ==========================================

def main():
    print("================================")
    print("PAPA CAMERA DETECTION STARTING")
    print("================================")

    folder, scan_id = create_scan_folder()

    photo_path = capture_photo(folder)

    image = cv2.imread(str(photo_path))

    if image is None:
        raise RuntimeError(
            "Could not load camera photograph"
        )

    markers = detect_red_markers(image)

    substrates, unmatched = pair_markers(markers)

    substrates = number_substrates(substrates)

    annotated = annotate_image(
        image,
        markers,
        substrates
    )

    detected_path = save_results(
        folder,
        scan_id,
        annotated,
        markers,
        substrates,
        unmatched
    )

    print(f"Scan: {scan_id:04d}")
    print(f"Red markers: {len(markers)}")
    print(f"Substrates: {len(substrates)}")
    print(f"Unmatched markers: {len(unmatched)}")

    for substrate in substrates:
        print(
            f"S{substrate['substrate_id']}: "
            f"({substrate['center_x']}, "
            f"{substrate['center_y']})"
        )

    print(f"Labeled photo saved: {detected_path}")

    # Open ONLY the processed photograph
    # This is not a mask or black background.
    try:
        subprocess.Popen([
            "xdg-open",
            str(detected_path)
        ])
    except OSError:
        print(
            "Photo saved; automatic preview unavailable."
        )

    print("================================")
    print("SCAN COMPLETE")
    print("================================")


if __name__ == "__main__":
    main()
