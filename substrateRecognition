
import cv2
import numpy as np
import subprocess
import json
from pathlib import Path

# ==========================================
# PAPA - RED MARKER SUBSTRATE DETECTION
# ==========================================

BASE_DIR = Path(__file__).resolve().parent
SCANS_DIR = BASE_DIR / "scans"

PHOTO_WIDTH = 4056
PHOTO_HEIGHT = 3040
PREVIEW_TIME = 5000

MIN_RED_AREA = 100

# Marker pair geometry
MIN_DIAGONAL_DX = 30
MIN_DIAGONAL_DY = 30
MAX_PAIR_DISTANCE = 1200

# Pair spacing must be reasonably consistent
SPACING_TOLERANCE = 0.25

# Numbering tolerance (pixels)
ROW_TOLERANCE = 150

# Black label appearance
LABEL_SCALE = 2.0
LABEL_THICKNESS = 5


# ==========================================
# 1. CREATE A NUMBERED SCAN FOLDER
# ==========================================

def create_scan_folder():
    SCANS_DIR.mkdir(exist_ok=True)

    existing_ids = []

    for folder in SCANS_DIR.glob("scan_*"):
        if folder.is_dir():
            try:
                existing_ids.append(
                    int(folder.name.split("_")[-1])
                )
            except ValueError:
                continue

    scan_id = max(existing_ids, default=0) + 1
    folder = SCANS_DIR / f"scan_{scan_id:04d}"
    folder.mkdir()

    return folder, scan_id


# ==========================================
# 2. CAPTURE PHOTOGRAPH
# ==========================================

def capture_photo(folder):
    path = folder / "original.jpg"

    subprocess.run(
        [
            "rpicam-still",
            "-t", str(PREVIEW_TIME),
            "--width", str(PHOTO_WIDTH),
            "--height", str(PHOTO_HEIGHT),
            "-o", str(path)
        ],
        check=True
    )

    return path


# ==========================================
# 3. DETECT RED MARKERS
# ==========================================

def detect_red_markers(image):
    hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)

    mask1 = cv2.inRange(
        hsv,
        np.array([0, 100, 80]),
        np.array([10, 255, 255])
    )

    mask2 = cv2.inRange(
        hsv,
        np.array([170, 100, 80]),
        np.array([179, 255, 255])
    )

    mask = cv2.bitwise_or(mask1, mask2)

    # Remove isolated red noise
    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_OPEN,
        np.ones((5, 5), np.uint8)
    )

    # Join fragmented parts of the same marker
    kernel = cv2.getStructuringElement(
        cv2.MORPH_ELLIPSE,
        (31, 31)
    )

    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_CLOSE,
        kernel
    )

    contours, _ = cv2.findContours(
        mask,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    markers = []

    for contour in contours:
        area = cv2.contourArea(contour)

        if area < MIN_RED_AREA:
            continue

        (x, y), radius = cv2.minEnclosingCircle(
            contour
        )

        markers.append({
            "x": round(float(x), 2),
            "y": round(float(y), 2),
            "radius": round(float(radius), 2)
        })

    markers.sort(key=lambda m: (m["y"], m["x"]))

    print(f"Red markers detected: {len(markers)}")

    return markers


# ==========================================
# 4. FIND VALID DIAGONAL PAIR CANDIDATES
# ==========================================

def build_pair_candidates(markers):
    candidates = []

    for i in range(len(markers)):
        for j in range(i + 1, len(markers)):
            a = markers[i]
            b = markers[j]

            dx = abs(b["x"] - a["x"])
            dy = abs(b["y"] - a["y"])

            distance = float(np.hypot(dx, dy))

            if dx < MIN_DIAGONAL_DX:
                continue

            if dy < MIN_DIAGONAL_DY:
                continue

            if distance > MAX_PAIR_DISTANCE:
                continue

            candidates.append({
                "i": i,
                "j": j,
                "dx": dx,
                "dy": dy,
                "distance": distance
            })

    return candidates


# ==========================================
# 5. ESTIMATE COMMON PAIR GEOMETRY
# ==========================================

def estimate_pair_geometry(candidates):
    """
    Estimate typical diagonal separation
    from shorter candidate connections.

    This is an initial estimate, not a
    calibrated physical measurement.
    """

    if not candidates:
        return None

    distances = sorted(
        c["distance"] for c in candidates
    )

    # Focus on the shorter candidate connections
    sample_count = max(
        1,
        len(distances) // 3
    )

    typical_distance = float(
        np.median(distances[:sample_count])
    )

    return typical_distance


# ==========================================
# 6. PAIR MARKERS WITHOUT REUSING THEM
# ==========================================

def pair_markers(markers):
    candidates = build_pair_candidates(markers)

    typical_distance = estimate_pair_geometry(
        candidates
    )

    if typical_distance is None:
        return [], list(range(len(markers)))

    # Keep pairs with similar diagonal lengths
    valid_candidates = []

    for candidate in candidates:
        relative_error = abs(
            candidate["distance"] -
            typical_distance
        ) / typical_distance

        if relative_error <= SPACING_TOLERANCE:
            candidate["error"] = relative_error
            valid_candidates.append(candidate)

    # Prefer spacing consistency, then distance
    valid_candidates.sort(
        key=lambda c: (
            c["error"],
            c["distance"]
        )
    )

    used = set()
    substrates = []

    for candidate in valid_candidates:
        i = candidate["i"]
        j = candidate["j"]

        if i in used or j in used:
            continue

        a = markers[i]
        b = markers[j]

        center_x = (a["x"] + b["x"]) / 2
        center_y = (a["y"] + b["y"]) / 2

        substrates.append({
            "marker_1": a,
            "marker_2": b,
            "center_x": round(center_x, 2),
            "center_y": round(center_y, 2),
            "pair_distance_px": round(
                candidate["distance"], 2
            )
        })

        used.add(i)
        used.add(j)

    unmatched = [
        i for i in range(len(markers))
        if i not in used
    ]

    return substrates, unmatched


# ==========================================
# 7. NUMBER SUBSTRATES BY ROW
# ==========================================

def number_substrates(substrates):
    ordered = sorted(
        substrates,
        key=lambda s: (
            s["center_y"],
            s["center_x"]
        )
    )

    rows = []

    for substrate in ordered:
        matching_row = None

        for row in rows:
            if abs(
                substrate["center_y"] -
                row["average_y"]
            ) <= ROW_TOLERANCE:
                matching_row = row
                break

        if matching_row is None:
            rows.append({
                "average_y": substrate["center_y"],
                "items": [substrate]
            })
        else:
            matching_row["items"].append(substrate)
            matching_row["average_y"] = float(
                np.mean([
                    s["center_y"]
                    for s in matching_row["items"]
                ])
            )

    rows.sort(key=lambda r: r["average_y"])

    numbered = []
    next_id = 1

    for row in rows:
        row["items"].sort(
            key=lambda s: s["center_x"]
        )

        for substrate in row["items"]:
            substrate["substrate_id"] = next_id
            numbered.append(substrate)
            next_id += 1

    return numbered


# ==========================================
# 8. DRAW LABELS ON ORIGINAL PHOTO
# ==========================================

def annotate_image(image, substrates):
    output = image.copy()

    for substrate in substrates:
        center_x = int(substrate["center_x"])
        center_y = int(substrate["center_y"])

        label = f"S{substrate['substrate_id']}"

        (text_width, text_height), baseline = (
            cv2.getTextSize(
                label,
                cv2.FONT_HERSHEY_SIMPLEX,
                LABEL_SCALE,
                LABEL_THICKNESS
            )
        )

        # Center label at midpoint of red dots
        text_x = center_x - text_width // 2
        text_y = center_y + text_height // 2

        cv2.putText(
            output,
            label,
            (text_x, text_y),
            cv2.FONT_HERSHEY_SIMPLEX,
            LABEL_SCALE,
            (0, 0, 0),
            LABEL_THICKNESS,
            cv2.LINE_AA
        )

    return output


# ==========================================
# 9. SAVE LABELED PHOTO AND JSON
# ==========================================

def save_results(
    folder,
    scan_id,
    annotated,
    markers,
    substrates,
    unmatched
):
    labeled_path = folder / "detected.jpg"

    if not cv2.imwrite(
        str(labeled_path),
        annotated
    ):
        raise RuntimeError(
            "Could not save detected.jpg"
        )

    data = {
        "scan_id": scan_id,
        "image_width": PHOTO_WIDTH,
        "image_height": PHOTO_HEIGHT,
        "coordinate_units": "pixels",
        "marker_count": len(markers),
        "substrate_count": len(substrates),
        "pairing_verified": False,
        "substrates": substrates,
        "unmatched_markers": [
            markers[i] for i in unmatched
        ]
    }

    with open(
        folder / "substrates.json", "w"
    ) as file:
        json.dump(data, file, indent=4)

    return labeled_path


# ==========================================
# 10. MAIN
# ==========================================

def main():
    print("================================")
    print("PAPA SUBSTRATE DETECTION")
    print("================================")

    folder, scan_id = create_scan_folder()

    photo_path = capture_photo(folder)

    image = cv2.imread(str(photo_path))

    if image is None:
        raise RuntimeError(
            "Could not load original photograph"
        )

    markers = detect_red_markers(image)

    substrates, unmatched = pair_markers(markers)

    substrates = number_substrates(substrates)

    annotated = annotate_image(
        image,
        substrates
    )

    labeled_path = save_results(
        folder,
        scan_id,
        annotated,
        markers,
        substrates,
        unmatched
    )

    print(f"Substrates identified: {len(substrates)}")
    print(f"Unmatched markers: {len(unmatched)}")

    for substrate in substrates:
        print(
            f"S{substrate['substrate_id']}: "
            f"center=({substrate['center_x']}, "
            f"{substrate['center_y']})"
        )

    print(f"Labeled photograph: {labeled_path}")

    # Open only the labeled photograph
    try:
        subprocess.Popen([
            "xdg-open",
            str(labeled_path)
        ])
    except OSError:
        print(
            "Photograph saved; preview unavailable."
        )

    print("================================")
    print("SCAN COMPLETE")
    print("================================")


if __name__ == "__main__":
    main()

