
import cv2
import numpy as np
import subprocess
import json
from pathlib import Path

# ==========================================
# PAPA CAMERA - SUBSTRATE DETECTION
# ==========================================

BASE_DIR = Path(__file__).resolve().parent
SCANS_DIR = BASE_DIR / "scans"

PHOTO_WIDTH = 4056
PHOTO_HEIGHT = 3040
PREVIEW_TIME = 5000

# RED MARKER DETECTION
MIN_RED_AREA = 100
RED_CLOSE_KERNEL = 31

# SUBSTRATE PAIRING
# Each substrate has exactly TWO diagonal red markers.
MIN_DIAGONAL_DX = 10
MIN_DIAGONAL_DY = 10
MAX_PAIR_DISTANCE = 1200

# Optional known spacing between markers (pixels).
# Leave as None until measured.
EXPECTED_DX = None
EXPECTED_DY = None
PAIR_TOLERANCE = 0.30

# NUMBERING
ROW_TOLERANCE = 150

# BLACK LABEL APPEARANCE
LABEL_SCALE = 2.0
LABEL_THICKNESS = 5


# ==========================================
# 1. CREATE NEW SCAN FOLDER
# ==========================================

def create_scan_folder():
    SCANS_DIR.mkdir(exist_ok=True)

    existing_ids = []

    for folder in SCANS_DIR.glob("scan_*"):
        if folder.is_dir():
            try:
                existing_ids.append(
                    int(folder.name.split("_")[-1])
                )
            except ValueError:
                continue

    scan_id = max(existing_ids, default=0) + 1
    folder = SCANS_DIR / f"scan_{scan_id:04d}"
    folder.mkdir()

    print(f"Created {folder}")

    return folder, scan_id


# ==========================================
# 2. TAKE PHOTO
# ==========================================

def capture_photo(folder):
    photo_path = folder / "original.jpg"

    print("Starting Raspberry Pi HQ Camera...")

    subprocess.run(
        [
            "rpicam-still",
            "-t", str(PREVIEW_TIME),
            "--width", str(PHOTO_WIDTH),
            "--height", str(PHOTO_HEIGHT),
            "-o", str(photo_path)
        ],
        check=True
    )

    print("Photo captured!")

    return photo_path


# ==========================================
# 3. DETECT RED REGIONS
# ==========================================

def detect_red_markers(image):
    hsv = cv2.cvtColor(
        image,
        cv2.COLOR_BGR2HSV
    )

    # Red wraps around the HSV hue range
    mask1 = cv2.inRange(
        hsv,
        np.array([0, 100, 80]),
        np.array([10, 255, 255])
    )

    mask2 = cv2.inRange(
        hsv,
        np.array([170, 100, 80]),
        np.array([179, 255, 255])
    )

    mask = cv2.bitwise_or(mask1, mask2)

    # Remove tiny isolated red pixels
    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_OPEN,
        np.ones((5, 5), np.uint8)
    )

    # Connect fragmented parts of one marker
    close_kernel = cv2.getStructuringElement(
        cv2.MORPH_ELLIPSE,
        (RED_CLOSE_KERNEL, RED_CLOSE_KERNEL)
    )

    mask = cv2.morphologyEx(
        mask,
        cv2.MORPH_CLOSE,
        close_kernel
    )

    contours, _ = cv2.findContours(
        mask,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    markers = []

    for contour in contours:
        area = cv2.contourArea(contour)

        if area < MIN_RED_AREA:
            continue

        (x, y), radius = cv2.minEnclosingCircle(
            contour
        )

        markers.append({
            "x": round(float(x), 2),
            "y": round(float(y), 2),
            "radius": round(float(radius), 2),
            "area": round(float(area), 2)
        })

    markers.sort(
        key=lambda m: (m["y"], m["x"])
    )

    print(f"Detected {len(markers)} red markers")

    return markers


# ==========================================
# 4. PAIR TWO DIAGONAL MARKERS
# ==========================================

def pair_markers(markers):
    """
    Pair diagonal red markers into substrates.

    Each marker may be used only once.

    If expected spacing is not configured,
    prefer the closest valid diagonal pair.

    Check the labeled photo to confirm pairs.
    """

    candidates = []

    for i in range(len(markers)):
        for j in range(i + 1, len(markers)):
            a = markers[i]
            b = markers[j]

            dx = abs(b["x"] - a["x"])
            dy = abs(b["y"] - a["y"])

            distance = float(np.hypot(dx, dy))

            if dx < MIN_DIAGONAL_DX:
                continue

            if dy < MIN_DIAGONAL_DY:
                continue

            if distance > MAX_PAIR_DISTANCE:
                continue

            if EXPECTED_DX is not None:
                if abs(dx - EXPECTED_DX) > (
                    EXPECTED_DX * PAIR_TOLERANCE
                ):
                    continue

            if EXPECTED_DY is not None:
                if abs(dy - EXPECTED_DY) > (
                    EXPECTED_DY * PAIR_TOLERANCE
                ):
                    continue

            if (
                EXPECTED_DX is not None
                and EXPECTED_DY is not None
            ):
                score = (
                    abs(dx - EXPECTED_DX) / EXPECTED_DX
                    + abs(dy - EXPECTED_DY) / EXPECTED_DY
                )
            else:
                score = distance

            candidates.append({
                "i": i,
                "j": j,
                "distance": distance,
                "score": score
            })

    candidates.sort(
        key=lambda c: c["score"]
    )

    used = set()
    substrates = []

    for candidate in candidates:
        i = candidate["i"]
        j = candidate["j"]

        if i in used or j in used:
            continue

        a = markers[i]
        b = markers[j]

        center_x = (a["x"] + b["x"]) / 2
        center_y = (a["y"] + b["y"]) / 2

        substrates.append({
            "marker_1": a,
            "marker_2": b,
            "center_x": round(center_x, 2),
            "center_y": round(center_y, 2),
            "pair_distance_px": round(
                candidate["distance"], 2
            )
        })

        used.add(i)
        used.add(j)

    unmatched = [
        i for i in range(len(markers))
        if i not in used
    ]

    print(
        f"Identified {len(substrates)} candidate substrates"
    )

    return substrates, unmatched


# ==========================================
# 5. NUMBER LEFT TO RIGHT, TOP TO BOTTOM
# ==========================================

def number_substrates(substrates):
    ordered = sorted(
        substrates,
        key=lambda s: (
            s["center_y"],
            s["center_x"]
        )
    )

    rows = []

    for substrate in ordered:
        matching_row = None

        for row in rows:
            if abs(
                substrate["center_y"] -
                row["average_y"]
            ) <= ROW_TOLERANCE:
                matching_row = row
                break

        if matching_row is None:
            rows.append({
                "average_y": substrate["center_y"],
                "items": [substrate]
            })
        else:
            matching_row["items"].append(
                substrate
            )

            matching_row["average_y"] = float(
                np.mean([
                    s["center_y"]
                    for s in matching_row["items"]
                ])
            )

    rows.sort(
        key=lambda row: row["average_y"]
    )

    numbered = []
    next_id = 1

    for row in rows:
        row["items"].sort(
            key=lambda s: s["center_x"]
        )

        for substrate in row["items"]:
            substrate["substrate_id"] = next_id
            numbered.append(substrate)
            next_id += 1

    return numbered


# ==========================================
# 6. DRAW GREEN CIRCLES AND BLACK LABELS
# ==========================================

def annotate_image(image, markers, substrates):
    # Keep the original photograph as background
    output = image.copy()

    # GREEN CIRCLES around ALL detected red markers
    for marker in markers:
        center = (
            int(marker["x"]),
            int(marker["y"])
        )

        radius = max(
            10,
            int(marker["radius"]) + 5
        )

        cv2.circle(
            output,
            center,
            radius,
            (0, 255, 0),
            5
        )

    # BLACK LABEL for each identified substrate
    for substrate in substrates:
        center_x = int(substrate["center_x"])
        center_y = int(substrate["center_y"])

        label = f"S{substrate['substrate_id']}"

        (text_width, text_height), baseline = (
            cv2.getTextSize(
                label,
                cv2.FONT_HERSHEY_SIMPLEX,
                LABEL_SCALE,
                LABEL_THICKNESS
            )
        )

        # Center label between the two red markers
        text_x = center_x - text_width // 2
        text_y = center_y + text_height // 2

        cv2.putText(
            output,
            label,
            (text_x, text_y),
            cv2.FONT_HERSHEY_SIMPLEX,
            LABEL_SCALE,
            (0, 0, 0),
            LABEL_THICKNESS,
            cv2.LINE_AA
        )

    return output


# ==========================================
# 7. SAVE ORIGINAL AND LABELED PHOTO
# ==========================================

def save_results(
    folder,
    scan_id,
    annotated,
    markers,
    substrates,
    unmatched
):
    labeled_path = folder / "detected.jpg"

    if not cv2.imwrite(
        str(labeled_path),
        annotated
    ):
        raise RuntimeError(
            "Could not save labeled photograph"
        )

    results = {
        "scan_id": scan_id,
        "image_width": PHOTO_WIDTH,
        "image_height": PHOTO_HEIGHT,
        "coordinate_units": "pixels",
        "marker_count": len(markers),
        "substrate_count": len(substrates),
        "pairing_verified": False,
        "substrates": substrates,
        "unmatched_markers": [
            markers[i] for i in unmatched
        ]
    }

    json_path = folder / "substrates.json"

    with open(json_path, "w") as file:
        json.dump(
            results,
            file,
            indent=4
        )

    print("Results saved successfully!")

    return labeled_path


# ==========================================
# 8. MAIN PROGRAM
# ==========================================

def main():
    print("================================")
    print("PAPA CAMERA DETECTION STARTING")
    print("================================")

    # Create a new scan folder
    folder, scan_id = create_scan_folder()

    # Take photograph
    photo_path = capture_photo(folder)

    # Load photograph
    image = cv2.imread(str(photo_path))

    if image is None:
        raise RuntimeError(
            "Could not load camera photograph"
        )

    # Detect all red markers
    markers = detect_red_markers(image)

    # Pair diagonal markers
    substrates, unmatched = pair_markers(markers)

    # Assign unique substrate numbers
    substrates = number_substrates(substrates)

    # Draw green circles and black S1/S2 labels
    annotated = annotate_image(
        image,
        markers,
        substrates
    )

    # Save processed photograph and JSON
    labeled_path = save_results(
        folder,
        scan_id,
        annotated,
        markers,
        substrates,
        unmatched
    )

    print(f"Scan ID: {scan_id:04d}")
    print(f"Red markers: {len(markers)}")
    print(f"Substrates: {len(substrates)}")
    print(f"Unmatched markers: {len(unmatched)}")

    for substrate in substrates:
        print(
            f"S{substrate['substrate_id']}: "
            f"center=({substrate['center_x']}, "
            f"{substrate['center_y']})"
        )

    print(f"Labeled photo: {labeled_path}")

    # Open ONLY the labeled photograph
    try:
        subprocess.Popen([
            "xdg-open",
            str(labeled_path)
        ])
    except OSError:
        print(
            "Photograph saved; automatic preview unavailable."
        )

    print("================================")
    print("SCAN COMPLETE")
    print("================================")


if __name__ == "__main__":
    main()
