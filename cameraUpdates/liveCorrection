"""Live, always-on distortion correction for the HQ Camera.

Streams the camera in its native 2028 x 1080 video mode (up to 50 frames per
second), corrects every frame, and serves the corrected video to any browser
on your network:

    http://<pi-address>:8000/              live view
    http://<pi-address>:8000/stream.mjpg   video stream (cv2.VideoCapture can open this URL)
    http://<pi-address>:8000/snapshot.jpg  latest corrected frame

Keep this file next to camera_correction.py.

    python3 live_correct.py                # run the live view
    python3 live_correct.py --scale 1.0    # full-size stream (slower)
    python3 live_correct.py --show         # also show a window on the Pi's own screen
    python3 live_correct.py --file a.jpg   # test with a saved 2028 x 1080 photo

Only one program can use the camera at a time. Stop this before taking a scan
with papa_detection.py.
"""

import argparse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import socket
import threading
import time

import cv2
import numpy as np

import camera_correction as cc

VIDEO_SIZE = (2028, 1080)  # HQ Camera 1080p video mode, 2 x 2 binned

PAGE = b"""<!doctype html><html><head><meta charset="utf-8"><title>Corrected camera</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>body{margin:0;background:#111;color:#ddd;font:14px sans-serif}
img{display:block;max-width:100%;margin:auto}p{text-align:center}</style></head>
<body><img src="/stream.mjpg" alt="Corrected camera stream">
<p>Corrected live view &middot; <a style="color:#9cf" href="/snapshot.jpg">snapshot</a></p></body></html>"""


# ---- Camera ----------------------------------------------------------------------
def camera_frames():
    from picamera2 import Picamera2

    camera = Picamera2()
    main = {"size": VIDEO_SIZE, "format": "RGB888"}  # BGR order, as OpenCV expects
    try:  # select the 2028 x 1080 sensor mode explicitly
        config = camera.create_video_configuration(main=main, sensor={"output_size": VIDEO_SIZE})
    except TypeError:  # older Picamera2
        config = camera.create_video_configuration(main=main, raw={"size": VIDEO_SIZE})
    camera.configure(config)
    camera.start()
    try:
        while True:
            yield camera.capture_array()
    finally:
        camera.stop()
        camera.close()


def file_frames(path, fps=15):
    frame = cv2.imread(path)
    if frame is None:
        raise SystemExit(f"Could not open {path}")
    while True:
        yield frame
        time.sleep(1 / fps)


# ---- Fast correction -------------------------------------------------------------
def build_fast_maps(correction, scale):
    """Precompute where every output pixel comes from, at the chosen output scale."""
    width = int(round(correction.output_size[0] * scale))
    height = int(round(correction.output_size[1] * scale))
    xs, ys = np.meshgrid((np.arange(width) + 0.5) / scale - 0.5,
                         (np.arange(height) + 0.5) / scale - 0.5)
    source = correction.to_original(np.c_[xs.ravel(), ys.ravel()])
    map_x = source[:, 0].reshape(height, width).astype(np.float32)
    map_y = source[:, 1].reshape(height, width).astype(np.float32)
    return cv2.convertMaps(map_x, map_y, cv2.CV_16SC2)  # fixed-point maps remap faster


# ---- Stream server ----------------------------------------------------------------
class LatestFrame:
    def __init__(self):
        self.condition = threading.Condition()
        self.jpeg = None
        self.count = 0

    def put(self, jpeg):
        with self.condition:
            self.jpeg = jpeg
            self.count += 1
            self.condition.notify_all()

    def wait_for_new(self, last_count):
        with self.condition:
            self.condition.wait_for(lambda: self.count != last_count, timeout=5)
            return self.count, self.jpeg


LATEST = LatestFrame()


class Handler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def send_bytes(self, body, content_type):
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        path = self.path.split("?")[0]
        if path in ("/", "/index.html"):
            self.send_bytes(PAGE, "text/html; charset=utf-8")
        elif path == "/snapshot.jpg":
            _, jpeg = LATEST.wait_for_new(-1)
            if jpeg is None:
                self.send_error(503, "No frame yet")
            else:
                self.send_bytes(jpeg, "image/jpeg")
        elif path == "/stream.mjpg":
            self.send_response(200)
            self.send_header("Content-Type", "multipart/x-mixed-replace; boundary=frame")
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            count = 0
            try:
                while True:
                    count, jpeg = LATEST.wait_for_new(count)
                    if jpeg is None:
                        continue
                    self.wfile.write(b"--frame\r\nContent-Type: image/jpeg\r\n")
                    self.wfile.write(b"Content-Length: %d\r\n\r\n" % len(jpeg))
                    self.wfile.write(jpeg + b"\r\n")
            except (BrokenPipeError, ConnectionResetError):
                pass
        else:
            self.send_error(404)


def local_address():
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
            s.connect(("10.255.255.255", 1))  # no data is sent
            return s.getsockname()[0]
    except OSError:
        return "localhost"


# ---- Main loop ---------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(description="Live corrected camera stream")
    parser.add_argument("--file", help="use a saved 2028 x 1080 photo instead of the camera")
    parser.add_argument("--scale", type=float, default=0.5,
                        help="stream size relative to the full corrected view (default 0.5)")
    parser.add_argument("--quality", type=int, default=80, help="JPEG quality (default 80)")
    parser.add_argument("--port", type=int, default=8000)
    parser.add_argument("--show", action="store_true", help="show a window on this screen")
    args = parser.parse_args()

    print("Preparing correction maps...")
    correction = cc.get_correction(VIDEO_SIZE)
    map1, map2 = build_fast_maps(correction, args.scale)
    print(f"Stream scale: one checkerboard square = "
          f"{correction.pixels_per_square * args.scale:.1f} px")

    server = ThreadingHTTPServer(("0.0.0.0", args.port), Handler)
    server.daemon_threads = True
    threading.Thread(target=server.serve_forever, daemon=True).start()
    print(f"Live view: http://{local_address()}:{args.port}/   (Ctrl+C to stop)")

    frames, started = 0, time.time()
    try:
        for frame in (file_frames(args.file) if args.file else camera_frames()):
            if frame.shape[1::-1] != VIDEO_SIZE:
                raise SystemExit(f"Got {frame.shape[1]} x {frame.shape[0]} frames, expected "
                                 f"{VIDEO_SIZE[0]} x {VIDEO_SIZE[1]}.")
            corrected = cv2.remap(frame, map1, map2, cv2.INTER_LINEAR)
            ok, jpeg = cv2.imencode(".jpg", corrected, [cv2.IMWRITE_JPEG_QUALITY, args.quality])
            if ok:
                LATEST.put(jpeg.tobytes())
            if args.show:
                cv2.imshow("Corrected camera (press q to quit)", corrected)
                if cv2.waitKey(1) & 0xFF == ord("q"):
                    break
            frames += 1
            if time.time() - started >= 10:
                print(f"{frames / (time.time() - started):.1f} frames per second")
                frames, started = 0, time.time()
    except KeyboardInterrupt:
        pass
    finally:
        server.shutdown()
        if args.show:
            cv2.destroyAllWindows()


if __name__ == "__main__":
    main()
